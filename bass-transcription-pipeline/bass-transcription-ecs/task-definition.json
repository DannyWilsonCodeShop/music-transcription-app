{
  "family": "bass-transcription-dev",
  "taskRoleArn": "arn:aws:iam::090130568474:role/chordscout-v2-dev-ECSTaskRole-QBhvp2gMiDG7",
  "executionRoleArn": "arn:aws:iam::090130568474:role/chordscout-v2-dev-ECSTaskExecutionRole-tKJbfiovNGLj",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",
  "containerDefinitions": [
    {
      "name": "bass-transcription",
      "image": "090130568474.dkr.ecr.us-east-1.amazonaws.com/bass-transcription:v3.0-phase2-m4a-fix",
      "essential": true,
      "environment": [
        {
          "name": "S3_AUDIO_BUCKET",
          "value": "chordscout-audio-temp-dev-090130568474"
        },
        {
          "name": "DYNAMODB_JOBS_TABLE",
          "value": "ChordScout-Jobs-V2-dev"
        },
        {
          "name": "PDF_GENERATOR_FUNCTION",
          "value": "bass-nns-pdf-generator-dev"
        },
        {
          "name": "GENIUS_ACCESS_TOKEN",
          "value": "PLACEHOLDER_SET_IN_SECRETS_MANAGER"
        },
        {
          "name": "ENABLE_LYRICS",
          "value": "false"
        },
        {
          "name": "ENABLE_MULTI_STEM",
          "value": "true"
        },
        {
          "name": "DEFAULT_TRANSCRIPTION_MODE",
          "value": "bass-only"
        },
        {
          "name": "CONFIRMATION_TIMEOUT",
          "value": "300"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bass-transcription-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
